# Virtual environment — VS Code detects .venv automatically
.venv/
venv/
env/

# Credentials — NEVER commit your WRDS username or any secrets
.env

# Raw data — licensing restrictions; files may be large
data/raw/

# Reference PDFs — managed by Zotero, too large for Git
references/*.pdf

# Python cache
*.pyc
__pycache__/
*.egg-info/
.ipynb_checkpoints/

# Quarto render output (regenerated by `task render`)
research_note.pdf
research_note.html
_quarto/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
*.swp
